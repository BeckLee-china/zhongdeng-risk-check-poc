PORT=8787
DATA_DIR=./data

# 正常启动默认走真实中登浏览器；只有显式改成 mock 才会使用演示数据。
ZHONGDENG_ADAPTER=browser

# 内部合同/发票系统尚未接入时可先保留 mock；界面会明确提示。
INTERNAL_ADAPTER=mock
INTERNAL_API_BASE=
INTERNAL_API_TOKEN=

ZD_LOGIN_URL=https://www.zhongdengwang.org.cn/
ZD_HOME_URL=https://www.zhongdengwang.org.cn/out/?#/home/
ZD_QUERY_URL=https://www.zhongdengwang.org.cn/out/?#/query/guarantor/

# macOS 已安装 Chrome 可用 chrome；Windows 建议改为 msedge。
# 留空则使用 Playwright 自带 Chromium（需先 npm run playwright:install）。
ZD_BROWSER_CHANNEL=chrome
ZD_PROFILE_DIR=./data/zhongdeng-profile
ZD_TIMEOUT_MS=600000

# 查询页以中文标签定位为主；页面改版时可用这些 selector 覆盖。
ZD_CUSTOMER_NAME_SELECTOR=
ZD_QUERY_REASON_SELECTOR=
ZD_NEED_CERTIFICATE_SELECTOR=
ZD_QUERY_CAPTCHA_SELECTOR=
ZD_RESULT_READY_SELECTOR=

ZD_RESULT_DOWNLOAD_DIR=./storage/query-results
ATTACHMENT_DIR=./storage/attachments

OCR_HTTP_ENDPOINT=
OCR_HTTP_TOKEN=
